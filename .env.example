# Generate both secrets independently, for example with:
# py -3 -c "import secrets; print(secrets.token_urlsafe(48))"
FACECODE_SECRET_KEY=replace-with-at-least-32-random-characters
FACECODE_RUNNER_SECRET=replace-with-a-different-32-character-secret

FACECODE_ENV=production
FACECODE_CORS_ORIGINS=https://facecode.example.com
FACECODE_TRUSTED_HOSTS=facecode.example.com
FACECODE_LOG_LEVEL=INFO
FACECODE_RETENTION_DAYS=30
